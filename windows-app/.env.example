# Public configuration only. Never put a service-account key or TURN API key here.
# The native and renderer URLs are configured together in electron/urls.cjs:
# API_URL=https://facetimeos.onrender.com
# WEB_URL=https://facetimeos.vercel.app
# Firebase NEXT_PUBLIC_FIREBASE_* values are read from ../client/.env.local.
# In CI, set those same public values as environment variables.
